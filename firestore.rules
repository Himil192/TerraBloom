rules_version = '2';
// =============================================================================
// TerraBloom - Cloud Firestore Security Rules
// -----------------------------------------------------------------------------
// THE REAL AUTHENTICATION/AUTHORIZATION WALL FOR THIS APP.
// Client-side route guards are UX only - these rules are enforced by Google's
// servers on every single request, so a hacker cannot bypass them by editing
// localStorage, React state, or the JS bundle.
//
// Model: roles live on the user's own doc at users/{uid}. Admin access is
// established by reading that doc (get()) inside the rule - never by trusting
// anything the client claims.
//
// Deploy:  firebase deploy --only firestore
// -----------------------------------------------------------------------------
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // True only if the caller's own user doc says role == 'admin'.
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // -------------------------------------------------------------------------
    // users/{uid} - each user manages their OWN profile only.
    // * create: ONLY via signup, which must write role == 'user'
    //   (a newly created account can never claim admin this way).
    // * update: ONLY own doc, and the role field must stay UNCHANGED.
    // * delete: admins only (no self-destruct / no user-deletes-others).
    // * read: owner or admin.
    // -------------------------------------------------------------------------
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());

      allow create: if isSignedIn() &&
        request.auth.uid == uid &&
        request.resource.data.role == 'user' &&
        request.resource.data.email is string;

      allow update: if isSignedIn() &&
        request.auth.uid == uid &&
        request.resource.data.role == resource.data.role &&
        // wishlist mirror (Phase 5): owner may save a bounded product list on
        // their OWN doc. Bounds stop abuse (1MiB doc cap); snapshots in the
        // list are display-only and never trusted for pricing.
        (!('wishlist' in request.resource.data) ||
          (request.resource.data.wishlist is list &&
            request.resource.data.wishlist.size() <= 50));

      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // products, blogs - public READ (catalog), ADMIN-ONLY writes.
    // -------------------------------------------------------------------------
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      // ---------------------------------------------------------------------
      // products/{id}/reviews - GENUINE customer reviews (Phase 6).
      // * read: public (reviews power the live rating shown on the page).
      // * create: signed-in authors only, writing AS THEMSELVES (uid locked
      //   to request.auth.uid), 1..5 integer rating, bounded text, full
      //   field whitelist. 'verified' must be a bool - the client computes
      //   it from the author's OWN order history (only the author can read
      //   it per the orders rule). Rules cannot query collections to
      //   re-verify this server-side on the free plan; a tampered client
      //   could only fake the badge on its OWN review - it can never touch
      //   another user's reviews or the rating math below.
      // * update: NEVER. Reviews are immutable (delete + repost), so rating
      //   aggregates computed from them cannot be rewritten post-hoc.
      // * delete: the author, or an admin (moderation).
      // ---------------------------------------------------------------------
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isSignedIn() &&
          // One review per user per product: the review doc ID IS the uid,
          // so a second review by the same author is structurally impossible.
          reviewId == request.auth.uid &&
          request.resource.data.keys().hasOnly(
            ['uid', 'userName', 'rating', 'text', 'verified', 'createdAt']
          ) &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.rating is int &&
          request.resource.data.rating >= 1 &&
          request.resource.data.rating <= 5 &&
          request.resource.data.text is string &&
          request.resource.data.text.size() >= 1 &&
          request.resource.data.text.size() <= 1000 &&
          request.resource.data.userName is string &&
          request.resource.data.userName.size() >= 1 &&
          request.resource.data.userName.size() <= 80 &&
          request.resource.data.verified is bool;
        allow update: if false;
        allow delete: if isAdmin() ||
          (isSignedIn() && resource.data.uid == request.auth.uid);
      }
    }

    match /blogs/{blogId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // orders - customer PII. Reads: admin OR the owning user only.
    // * create: signed-in users (checkout), strictly validated:
    //   - userId MUST equal the caller's uid (cannot order as someone else,
    //     and can never read another user's orders afterwards)
    //   - status must start as 'Processing' - the lifecycle is admin-owned
    //   - paymentMethod locked to 'Cash on Delivery' (gateway comes later)
    //   - field whitelist + length bounds on all PII strings
    //   - items bounded 1..50
    //   NOTE: the rules language has no per-list-item iteration, so line
    //   prices are snapshot copies the admin Orders page re-verifies against
    //   live product docs (mismatches are flagged). Payment is COD settled at
    //   delivery, so admin review is the enforcement point until a Cloud
    //   Function can price orders server-side.
    // * update/delete: admin only.
    // -------------------------------------------------------------------------
    match /orders/{orderId} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
      allow create: if isSignedIn() &&
        request.resource.data.keys().hasOnly(
          ['orderNumber', 'userId', 'status', 'items', 'subtotal', 'tax', 'total', 'customerName', 'customerEmail', 'phone', 'address', 'paymentMethod', 'createdAt']
        ) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'Processing' &&
        request.resource.data.paymentMethod == 'Cash on Delivery' &&
        request.resource.data.customerName is string &&
        request.resource.data.customerName.size() >= 2 &&
        request.resource.data.customerName.size() <= 80 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() >= 8 &&
        request.resource.data.phone.size() <= 15 &&
        request.resource.data.address is string &&
        request.resource.data.address.size() >= 10 &&
        request.resource.data.address.size() <= 500 &&
        request.resource.data.total is number &&
        request.resource.data.total >= 0 &&
        request.resource.data.total <= 1000000 &&
        request.resource.data.items is list &&
        request.resource.data.items.size() >= 1 &&
        request.resource.data.items.size() <= 50;
    }

    // -------------------------------------------------------------------------
    // newsletter - any visitor may subscribe (append-only, field whitelisted).
    // -------------------------------------------------------------------------
    match /newsletter/{subscriberId} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['email', 'timestamp']) &&
        request.resource.data.email is string;
    }

    // -------------------------------------------------------------------------
    // messages (contact form) - signed-in users may submit; admin manages.
    // -------------------------------------------------------------------------
    match /messages/{messageId} {
      allow read, update, delete: if isAdmin();
      allow create: if isSignedIn();
    }

    // -------------------------------------------------------------------------
    // settings/{docId} - public store info (name, contact, currency) shown on
    // the storefront; writes are admin-only.
    // -------------------------------------------------------------------------
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Explicitly deny everything we have not listed (default-deny).
  }
}